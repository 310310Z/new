# Node.js / JavaScript / TypeScript 関連
/node_modules              # Node.jsの依存関係
npm-debug.log*             # npmのデバッグログ
yarn-debug.log*            # Yarnのデバッグログ
yarn-error.log*            # Yarnエラーログ
.pnp                       # PnP (Plug'n'Play) 設定
.pnp.*                     # PnP設定の補助ファイル
.yarn/                     # Yarnの管理ディレクトリ
!.yarn/patches             # 特定のパッチを除外
!.yarn/plugins             # 特定のプラグインを除外
!.yarn/releases            # 特定のリリースを除外
!.yarn/versions            # 特定のバージョンを除外

# テスト結果 / カバレッジ
/coverage                  # テストカバレッジ結果

# Next.js のビルド出力
/.next/                    # Next.js のビルド出力
/out/                      # 静的サイト生成の出力

# 生産環境のビルド出力
/build                     # その他のビルドディレクトリ（例: Vercel など）

# メタファイル / アーティファクト
.DS_Store                  # MacOS のメタファイル
*.pem                      # 証明書ファイル

# 環境変数設定ファイル
.env                       # 環境設定ファイル（Git に含めない）
.env.local                 # ローカル環境変数（Git に含めない）
.env.development           # 開発環境
.env.test                  # テスト環境
.env.production            # 本番環境
.env.staging               # ステージング環境

# Vercel (デプロイメントサービス)
.vercel                    # Vercelのデプロイメント関連

# TypeScript 関連
*.tsbuildinfo              # TypeScriptのビルド情報
next-env.d.ts              # Next.js の自動生成された型定義

# Docker 関連
docker-compose.yml         # Docker Composeの設定ファイル（含める）
dockerfile                 # Dockerfile（含める）

# ローカル IDE / エディタ設定
.vscode                    # VSCodeの設定ファイル
.idea                      # JetBrains系 IDE の設定ファイル

# コンパイル出力
/dist/                     # ビルド出力ディレクトリ
/public/_next/             # Next.jsの静的ファイル
*.bak                      # バックアップファイル
*.swp                      # スワップファイル
*.swo                      # スワップファイル

# 圧縮ファイル
*.tgz
*.tar.gz

# OS特有のメタファイル
Thumbs.db                  # Windowsのサムネイルキャッシュ
Desktop.ini                # Windowsの設定ファイル
